RewriteEngine On

# 403 — file cấu hình
RewriteRule ^config\.local\.php$ php/Pages/error.php?code=403 [L]

# 403 — directory listing (RewriteRule ưu tiên, Options -Indexes làm fallback)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^(.*)$ php/Pages/error.php?code=403 [L]
Options -Indexes

# 404 — file/thư mục không tồn tại
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ php/Pages/error.php?code=404 [L]
