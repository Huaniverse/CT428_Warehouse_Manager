# [SEC-08] Bảo vệ các file cấu hình khỏi truy cập trực tiếp
<FilesMatch "^config\.local\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Tắt directory listing
Options -Indexes

# Ẩn lỗi PHP trên môi trường thật (tuỳ chọn)
# php_flag display_errors off

# Trang lỗi tùy chỉnh
ErrorDocument 403 /thuchanh/CT428_Warehouse_Manager/php/Pages/error.php?code=403
ErrorDocument 404 /thuchanh/CT428_Warehouse_Manager/php/Pages/error.php?code=404
ErrorDocument 500 /thuchanh/CT428_Warehouse_Manager/php/Pages/error.php?code=500
